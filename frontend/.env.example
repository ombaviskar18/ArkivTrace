# Clerk Authentication (Required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Arkiv Network Configuration
NEXT_PUBLIC_ARKIV_NETWORK=tiramisu
ARKIV_PRIVATE_KEY=
ARKIV_API_KEY=

# Backend Express API URL
# In production, set this to your deployed backend URL (e.g., https://your-backend.railway.app/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Optional Demo Mode (true to use local mock data if backend is offline)
NEXT_PUBLIC_DEMO_MODE=false
