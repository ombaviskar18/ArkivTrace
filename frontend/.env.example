# Tiramisu (Arkiv testnet). Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_ARKIV_NETWORK=tiramisu

# Optional override. Default is the official Tiramisu RPC.
# ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Optional RPC access key (ark_live_...). Server-only; sent as X-API-KEY.
# This is not a wallet key and cannot sign transactions.
ARKIV_ACCESS_KEY=

# Wallet signing key for writes. Server-only. Format: 0x + 64 hex characters.
# Never prefix this with NEXT_PUBLIC_.
ARKIV_PRIVATE_KEY=
ARKIV_WALLET_ADDRESS=
