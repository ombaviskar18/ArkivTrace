# ArkivTrace Backend Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Arkiv Tiramisu Network RPC
# Official Docs: https://docs.arkiv.network/networks/tiramisu/
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7738577

# RPC Request Timeout in milliseconds (default: 10000ms)
ARKIV_RPC_TIMEOUT_MS=10000

# Operator / Admin Wallet Private Key (hex with 0x prefix)
# Used to sign Arkiv transactions (createEntity, patchEntity, etc.)
# Fund your address with testnet GLM at: https://hub.arkiv.network/faucet
ARKIV_PRIVATE_KEY=

# Optional hardening flag for production deployments.
# When NODE_ENV=production, /api/test/create is protected by admin role checks unless this is set to true.
# Keep false in production.
ALLOW_TEST_WRITES=false

# Clerk authentication (required for production auth)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
ALLOW_DEMO_ROLE_HEADERS=false
